<div class="form">
  {{#if error}}
  <div class="form-dsp-error">
    <i class="fa fa-xmark"></i>
    <span class="fa fa-error">{{error}}</span>
  </div>
  {{/if}}

  <div class="title">
    Adm<span id="highlight">i</span>n
  </div>

  <form action="/admin/login" method="POST">
    <div class="input-container ic2">
      <input id="username" class="input" name="username" type="text" placeholder=" " required />
      <div class="cut cut-short"></div>
      <label for="username" class="placeholder">Username</label>
    </div>

    <div class="input-container ic2">
      <input id="password" class="input" name="password" type="password" placeholder=" " required />
      <div class="cut cut-short"></div>
      <label for="password" class="placeholder">Password</label>
    </div>

    <div class="submit">
      <button type="submit" class="submit">
        <span>Login</span>
        <div class="liquid"></div>
      </button>
    </div>
  </form>
</div>
