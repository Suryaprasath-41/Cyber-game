<div class="mission-complete-container" style="color: white; text-align: center; margin-top: 100px; font-family: monospace;">
  <h1 style="font-size: 3rem; margin-bottom: 40px;">MISSION COMPLETE</h1>
  
  <div style="font-size: 1.5rem; max-width: 600px; margin: 0 auto; background: rgba(0,0,0,0.5); padding: 30px; border: 1px solid #333; line-height: 2;">
    <div>Overall Correct Answers: {{totalCorrect}}</div>
    <div>Overall Wrong Answers: {{totalWrong}}</div>
    <div>Overall Percentage: {{overallPercentage}}%</div>
    <div>Overall Time: {{formattedTime}}</div>
    <div>Final Weighted Score: {{finalWeightedScore}}</div>
    <div style="margin-top: 20px; font-size: 1rem; color: #aaa;">Completion Time: <script>document.write(new Date().toLocaleString())</script></div>
  </div>
  
  <h2 style="margin-top: 40px; color: #4CAF50; font-size: 2rem;">Congratulations</h2>
  
</div>
